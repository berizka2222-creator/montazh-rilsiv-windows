{
  "about": "Brand motion elements (Remotion) for reel-editor's motions.py: suggested next to the HyperFrames catalog. One entry per element in src/elements/index.ts; keep in sync when an element is added. Render: ~/motion/scripts/render-overlay.sh <Element> '<props>' <reel>/overlays/brand-<Element>-<slug>.webm, card: {type: overlay, brand: <Element>, src, start, end}.",
  "elements": [
